{
  "name": "keyhold",
  "version": "0.1.0",
  "private": true,
  "description": "Keyhold — an encrypted cloud credential vault with a Chrome/Edge extension.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run tests/rls.test.ts",
    "test:e2e": "node tests/e2e/run.mjs",
    "extension:build": "node extension/scripts/build.mjs",
    "extension:watch": "node extension/scripts/build.mjs --watch",
    "extension:icons": "node extension/scripts/icons.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:e2e:live": "node tests/e2e/run-live.mjs",
    "test:e2e:live:web": "node tests/e2e/run-live-web.mjs",
    "test:e2e:live:recovery": "node tests/e2e/run-live-recovery.mjs",
    "test:e2e:live:signup": "node tests/e2e/run-live-signup.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.49.4",
    "clsx": "^2.1.1",
    "motion": "^12.6.3",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.0.17",
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.13.14",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "esbuild": "^0.25.1",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.4",
    "happy-dom": "^17.4.4",
    "pg": "^8.13.3",
    "playwright-core": "^1.51.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.17",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
