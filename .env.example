# Supabase — local development values are printed by `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Public URL of this web app, used by the extension to link back.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Extension build values (copy extension/.env.example to extension/.env)
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=replace-with-local-anon-key
# KEYHOLD_APP_URL=http://localhost:3000
